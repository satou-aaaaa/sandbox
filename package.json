{
  "name": "kensetsu-kyoka-toolkit",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/satou-aaaaa/sandbox.git"
  },
  "type": "module",
  "description": "建設業許可の申請・更新業務を自動化するためのツールキット（要件判定エンジン／書類自動生成／更新リマインド）",
  "scripts": {
    "test": "node --test",
    "test:coverage": "node --experimental-test-coverage --test",
    "test:coverage:html": "c8 -r html -r text-summary node --test",
    "test:mutation": "stryker run",
    "test:a11y": "node --test test/accessibility.test.js",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check-secrets": "node hooks/check-secrets.mjs --all",
    "gen:eligibility": "node scripts/generate-eligibility-sample.js",
    "gen:youshiki1": "node scripts/generate-youshiki1-sample.js",
    "gen:youshiki2": "node scripts/generate-youshiki2-sample.js",
    "gen:youshiki6": "node scripts/generate-youshiki6-sample.js",
    "gen:youshiki7": "node scripts/generate-youshiki7-sample.js",
    "gen:youshiki8": "node scripts/generate-youshiki8-sample.js",
    "gen:youshiki16": "node scripts/generate-youshiki16-sample.js",
    "gen:youshiki20-2": "node scripts/generate-youshiki20-2-sample.js",
    "gen:youshiki25-14": "node scripts/generate-youshiki25-14-sample.js",
    "gen:reminder-digest": "node scripts/generate-reminder-digest-sample.js",
    "gen:kobutsu-eligibility": "node scripts/generate-kobutsu-eligibility-sample.js",
    "gen:kobutsu-shinseisho": "node scripts/generate-kobutsu-shinseisho-sample.js",
    "gen:kobutsu-seiyakusho": "node scripts/generate-kobutsu-seiyakusho-sample.js",
    "gen:kobutsu-rirekisho": "node scripts/generate-kobutsu-rirekisho-sample.js",
    "client:add": "node scripts/add-client.js",
    "client:remove": "node scripts/remove-client.js",
    "client:export": "node scripts/export-clients-csv.js",
    "client:import": "node scripts/import-clients-csv.js",
    "reminders": "node scripts/reminder-digest.js",
    "web": "node src/web/server.js"
  },
  "dependencies": {
    "docx": "^9.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^9.6.1",
    "@types/node": "^22.20.2",
    "axe-core": "^4.13.0",
    "c8": "^12.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-security": "^4.0.1",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
