# EditorConfig: エディタ間でインデント・改行コード・文字コードを統一する。
# .gitattributes（改行コードの正規化）を補完する位置づけ（docs/BEST_PRACTICES_AUDIT.md参照）。
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2
